import torch, pandas as pd
from datasets import load_dataset
from transformers import pipeline, set_seed
from sentence_transformers import SentenceTransformer
from sentence_transformers.util import cos_sim

set_seed(42)

data = load_dataset("truthfulqa/truthful_qa", "generation",
                   split="validation").shuffle(seed=42).select(range(5))

generator = pipeline("text-generation", model="gpt2",
                   device=0 if torch.cuda.is_available() else -1)

answers = [generator("Question: " + q + "\nAnswer:", max_new_tokens=40,
                     do_sample=False, pad_token_id=generator.tokenizer.eos_token_id)[0]["generated_text"].split("Answer:")[-1].strip()
           for q in data["question"]]

model = SentenceTransformer("sentence-transformers/all-MiniLM-L6-v2")

scores = cos_sim(model.encode(answers, convert_to_tensor=True),
                 model.encode(data["best_answer"], convert_to_tensor=True)).diagonal().tolist()

df = pd.DataFrame({"Question": data["question"], "Correct Answer": data["best_answer"],
                   "Generated Answer": answers, "Similarity": [round(s, 3) for s in scores]})

display(df)
print("Average Similarity:", round(sum(scores)/len(scores), 3))
